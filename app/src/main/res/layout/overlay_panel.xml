<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="900dp" android:layout_height="wrap_content" android:background="#0B0B0F" android:orientation="horizontal" android:padding="12dp" android:weightSum="3">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.6" android:orientation="vertical" android:background="#14151A" android:padding="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FF PANEL PRO" android:textColor="#A855F7" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="16dp" />
        <TextView android:text="⌂ Dashboard" android:textColor="#FFF" android:padding="12dp" android:background="#2E1065" android:layout_marginBottom="4dp"/>
        <TextView android:text="◎ Aimbot" android:textColor="#9CA3AF" android:padding="12dp" android:layout_marginBottom="4dp"/>
        <TextView android:text="👁 Visual" android:textColor="#9CA3AF" android:padding="12dp" android:layout_marginBottom="4dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="0dp" android:layout_height="400dp" android:layout_weight="1.4" android:paddingStart="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:text="Aimbot Settings" android:textColor="#FFF" android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#1A1B21" android:padding="12dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp">
                <TextView android:text="Auto Headshot" android:textColor="#FFF" android:layout_weight="1" />
                <Switch android:id="@+id/swAimbot" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#1A1B21" android:padding="12dp" android:layout_marginBottom="8dp">
                <TextView android:text="ESP Box" android:textColor="#FFF" android:layout_weight="1" />
                <Switch android:id="@+id/swEsp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#111118" android:padding="12dp">
        <TextView android:text="Status" android:textColor="#9CA3AF" />
        <TextView android:text="Ready" android:textColor="#22C55E" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
        <Button android:id="@+id/btnLaunch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LAUNCH GAME" android:backgroundTint="#A855F7" android:textColor="#FFF" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>￼Enter
